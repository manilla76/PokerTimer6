@inherits InputBase<string>

<input id="dataListStringInput" class="@CssClass" type="text" @bind-value="@CurrentStringValue"
       list="@dataListId" attributes="AdditionalAttributes"
       @oninput="UpdateEnteredText" @onkeydown="OnKeyDown" />
<datalist id="@dataListId">
    @if (DataList != null)
    {
        @foreach (var item in DataList)
        {
            <option value="@item" />
        }
    }
</datalist>

@code {
    private string dataListId = Guid.NewGuid().ToString();
    private string typedText = string.Empty;
    private bool _valueSetByTab = false;
    private bool previousParsingAttemptFailed = false;
    private ValidationMessageStore? _parsingValidationMessages;

    [Parameter, Required] public IEnumerable<string>? DataList { get; set; }       
    [Parameter] public bool RestrictToList { get; set; } = true;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab" && !string.IsNullOrWhiteSpace(typedText))
        {
            _valueSetByTab = true;
            SetValueFromTypedText();
        }
    }

    private void UpdateEnteredText(ChangeEventArgs e) => typedText = e.Value?.ToString() ?? string.Empty;

    private void SetValueFromTypedText()
    {
        if (DataList != null && DataList.Any(item => item.Contains(typedText, StringComparison.CurrentCultureIgnoreCase)))
        {
            var filteredList = DataList.Where(item => item.Contains(typedText, StringComparison.CurrentCultureIgnoreCase)).ToList();
            CurrentStringValue = filteredList.First();
        }
        else
        {
            CurrentStringValue = typedText;
        }
    }

    protected string CurrentStringValue 
    { 
        get
        {
            if (DataList != null && DataList.Contains(Value))
                return Value ?? string.Empty;
            else if (RestrictToList)
                return string.Empty;
            else
                return typedText;
        }
        set
        {
            _parsingValidationMessages ??= new ValidationMessageStore(EditContext);
            _parsingValidationMessages.Clear(FieldIdentifier);

            string val = string.Empty;
            bool haveValue = false;

            if (_valueSetByTab)
            {
                if (!string.IsNullOrWhiteSpace(typedText) && DataList != null)
                {
                    var filteredList = DataList.Where(item => item.Contains(typedText, StringComparison.CurrentCultureIgnoreCase)).ToList();
                    if (filteredList.Any())
                    {
                        val = filteredList[0];
                        haveValue = true;
                    }
                }
            }
            else if (RestrictToList && DataList != null)
            {
                haveValue = DataList.Contains(value);
                if (haveValue)
                    val = value;
            }
            else
            {
                haveValue = true;
                val = value;
            }

            if (haveValue)
            {
                CurrentValue = val;
                typedText = string.Empty;
                if (previousParsingAttemptFailed)
                {
                    EditContext.NotifyValidationStateChanged();
                    previousParsingAttemptFailed = false;
                }
            }
            else
            {
                _parsingValidationMessages.Add(FieldIdentifier, "You must choose a valid selection.");
                previousParsingAttemptFailed = true;
                EditContext.NotifyValidationStateChanged();
            }
            _valueSetByTab = false;
        }
    }

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out string result, [NotNullWhen(false)] out string validationErrorMessage)
        => throw new NotSupportedException($"This component does not parse string inputs. Bind to the '{nameof(CurrentValue)}' property, not '{nameof(CurrentValueAsString)}'");
}
