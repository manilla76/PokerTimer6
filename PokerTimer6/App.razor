@inject IHostEnvironment Env
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PokerTimer</title>
    <base href="/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="css/Poker.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="css/Autocomplete.css" rel="stylesheet" />
    <link href="PokerTimer6.styles.css" rel="stylesheet" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer"/>

    <script src="_framework/blazor.web.js"></script>
    
    <script>
        function setFocusToDataListString() {
            setTimeout(() => {
                const element = document.getElementById('dataListStringInput');
                if (element) {
                    element.focus();
                                    }
            }, 50); // Delay of 100 milliseconds
        }
    </script>



    <script>
        function preventDefaultTab(event) {
            if (event.key === "Tab") {
                event.preventDefault();
            }
        }
    </script>

    <script>
        window.PlaySound = () => {
            document.getElementById('alert').play();
        }
    </script>

</body>
</html>

