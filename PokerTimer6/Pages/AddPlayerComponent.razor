@inject IGameService Game
@inject IPlayerService Player
@inject IPayoutService Payout
@implements IDisposable

<EditForm Model="@playerModel" OnValidSubmit="@AddPlayer">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="input-group">
        <InputText @bind-Value="@playerModel.Name" placeholder="Player Name" />
        <button class="btn btn-outline-primary input-group-text">Add</button>
    </div>

</EditForm>
@*<input @bind="playerName" @onkeypress="@KeyEnterPressed" @bind:event="oninput"/><button @onclick="@AddPlayer">Add Player</button>*@
<br />
<label>Buy-In $<input class="m-lg-1" @bind="@PayoutService.BuyIn" style="width:70px" /></label>
<br />
<button class="oi oi-reload" @onclick="@Game.ResetTournament" title="Reset Tournament"/>

@code {
    [Parameter]
    public Player playerModel { get; set; } = new Player();

    public void AddPlayer()
    {
        if (Player.Players.Exists(p => p.Name == playerModel.Name) | string.IsNullOrEmpty(playerModel.Name))  //if the player already exists or empty...return
            return;
        Player.AddPlayer(new Player(Player.GetNextPlayerId(), playerModel.Name));
        if (Payout.PrizeMoney > 0)
        {
            Game.AddSeat();
        }
        StateHasChanged();
        playerModel.Name = "";
    }
    protected override Task OnInitializedAsync()
    {
        Player.OnChange += async () => await InvokeAsync(StateHasChanged);
        Game.OnChange += async () => await InvokeAsync(StateHasChanged);
        Payout.OnChange += async () => await InvokeAsync(StateHasChanged);
        return base.OnInitializedAsync();
    }
    void IDisposable.Dispose()
    {
        Player.OnChange -= async () => await InvokeAsync(StateHasChanged);
        Game.OnChange -= async () => await InvokeAsync(StateHasChanged);
        Payout.OnChange -= async () => await InvokeAsync(StateHasChanged);
    }
}
