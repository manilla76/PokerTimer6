@inject IGameService Game
<td>
    <button class="btn-close" @onclick="()=>Game.Rounds = new Queue<Round>(Game.Rounds.Where(r=>r!=round))" />
</td>
@if (@round.SmallBlind == 0)
{
    <td class="text-center text-primary" colspan="2">Break</td>
}
else
{
    <td class="text-end">@round.SmallBlind</td>
    <td class="text-end">@round.BigBlind</td>
}
<td class="text-end">@round.RoundTime.Minutes:@round.RoundTime.Seconds.ToString("00")</td>
<td />

@code {
    [Parameter]
    public Round round { get; set; } = new Round();
}
