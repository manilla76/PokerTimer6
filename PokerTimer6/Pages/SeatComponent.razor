@inject GameService Game

@*<h3>SeatComponent</h3>*@

@if (Game.Players.Count == 0)
{
    <p><em>Add Players</em></p>
}
else
{
    <div class="container-fluid">
        <div class="row">
            @for (int i = 1; i <= (Game.ActiveList.Count - 1) / 10 + 1; i++)   // table count  0 = 0 table; 1-10 = 1 table; 11-20 = 2 table
            {
                var table = i;
                <div class="col-lg-6 col-sm-12">
                    <button class="h2 btn btn-toolbar" @onclick="() => SetDealer(table)" title="Randomize dealer for this table.">Table @table</button>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Seat</th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in Game.ActiveList.Where(p=>p.Player_Seat.TableNumber == @table).OrderBy(t=>t.Player_Seat.SeatNumber))
                            {
                                <tr>
                                    
                                    @if (Game.Dealers.Count > 0 ? player.Player_Seat.SeatNumber == Game.Dealers[table - 1] : false )    // Check if this player is the dealer for this table
                                    {
                                        <td class="fw-bold fs-3 text-warning">@player.Name</td> }  // highlight dealer
                                    else{
                                        <td>@player.Name</td> }
                                    <td align="center">@player.Player_Seat.SeatNumber</td>
                                    <td/>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <p class="fw-bold fs-6 text-warning">Dealer Highlighted</p>
}
<button @onclick="@ShufflePlayers">Randomize</button> <br/>
Starting # of Players: @Game.StartingNumberOfPlayers <br/>
Current # of Players: @Game.ActiveList.Count
@code {
    private Random rng = new Random();
    //private List<int> dealers = new();
    public void Shuffle<T>(IList<T> list)  
    {  
        int n = list.Count;  
        while (n > 1) {  
            n--;  
            int k = rng.Next(n + 1);  
            T value = list[k];  
            list[k] = list[n];  
            list[n] = value;  
        } 
    }
    public void ShufflePlayers()
    {
        if (Game.ActiveList.Count == 0) 
        { 
            Game.StartingNumberOfPlayers = (uint)Game.Players.Count(p=>p.IsActive);
            Game.SetActivePayout();
        }
        Game.ActiveList = Game.Players.Where(p => p.IsActive).ToList();
        if (Game.ActiveList.Count == 0) return;
        Shuffle<Player>(Game.ActiveList);
        uint tableCount = (uint) (Game.ActiveList.Count - 1) / 10 + 1; 
        if (tableCount > 0 & Game.ActiveList.Count > 0)
        {
            for (int i = 0; i < Game.ActiveList.Count; i++)
            {
                Game.ActiveList[i].Player_Seat.TableNumber = (uint)i % tableCount + 1;
                Game.ActiveList[i].Player_Seat.SeatNumber = (uint)i / tableCount + 1;
            }
        }
        Game.Dealers.Clear();
        for (int i = 1; i <= tableCount; i++)
        {
            SetDealer(i);
        }
    }
    public void SetDealer(int table)
    {
        if (Game.Dealers.Count >= table)
        {
            Game.Dealers[table - 1] = rng.Next(1, Game.ActiveList.Count(p => p.Player_Seat.TableNumber == table) + 1);
        }
        else
        {
            Game.Dealers.Add(rng.Next(1, Game.ActiveList.Count(p => p.Player_Seat.TableNumber == table) + 1));  // Set dealer per table 
        }
        //StateHasChanged();
    }
}
