@inject GameService Game
@page "/players"
@implements IDisposable

<div class="container-fluid">
    <div class="row">
        <div class="col-xl-6 mb-5"><PlayerComponent/></div>
        <div class="col-xl-4"><SeatComponent/></div></div><br/>
    </div>
@code {
    protected override void OnInitialized()
    {
        Game.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Game.OnChange -= StateHasChanged;
    }
}
