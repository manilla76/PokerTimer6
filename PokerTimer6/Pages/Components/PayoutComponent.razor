@    using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@inject IPayoutService Payout
@implements IDisposable

<div class="top-row">Payout</div>    
<div class="sidebar-white">
    <br />
    @if (@Payout.ActivePayout.Payouts.Count == 0)
    {
        <p>Waiting for tournament to begin....</p>
    }
    else
    {
        <div class="col-5">
        <ol style="text-align:right">
        @foreach (var payout in @Payout.ActivePayout.Payouts)
        {
                <li>$@payout</li>
        }
        </ol>
        </div>
        <div class="col-auto"/>
    }
    <p>Current PrizePool: $@Payout.PrizeMoney</p>
    <button @onclick="Payout.AddPrizeMoney">Addon/Rebuy</button>
</div>

@code {
    protected override Task OnInitializedAsync()
    {
        Payout.OnChange += async () => await InvokeAsync(StateHasChanged);

        Payout.RoundPayoutsToNearest = int.Parse(Configuration["RoundPayoutsToNearest"]);
        if (Payout.Payouts.Count == 0)
        {
            Configuration.GetSection("Payouts").Bind(Payout.Payouts);
            Payout.ActivePayout.Payouts = new();
        }
        return base.OnInitializedAsync();
    }

    void IDisposable.Dispose()
    {
        Payout.OnChange -= async () => await InvokeAsync(StateHasChanged);
    }
}
