@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject IPayoutService Payout
@implements IDisposable
@rendermode InteractiveServer

<div class="top-row">Payout</div>    
<div class="sidebar-white">
    <br />
    @if (Payout.ActivePayout is null || @Payout.ActivePayout.Payouts.Count == 0)
    {
        <p>Waiting for tournament to begin....</p>
    }
    else
    {
        <div class="col-5">
        <ol style="text-align:right">
        @foreach (var payout in @Payout.ActivePayout.Payouts)
        {
                <li>$@payout</li>
        }
        </ol>
        </div>
        <div class="col-auto"/>
    }
    <p>Current PrizePool: $@Payout.PrizeMoney</p>
    <button @onclick="Payout.AddPrizeMoney">Addon/Rebuy</button>
</div>

@code {

    protected override void OnInitialized()
    {
        Payout.OnChange += HandleChange;
    }

    private Task HandleChange() => InvokeAsync(StateHasChanged);

    void IDisposable.Dispose()
    {
        Payout.OnChange -= HandleChange;
    }
}
