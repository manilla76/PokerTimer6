@inject IPlayerService Player
@inject IPayoutService Payout
@inject IGameService Game
@implements IDisposable
@rendermode InteractiveServer

@* <EditForm Model="@playerModel" OnValidSubmit="@AddPlayer">
    <DataAnnotationsValidator />
    <ValidationSummary /> *@
    <div class="input-group autocomplete w-50">
        <input @bind=filter 
            @oninput=HandleInput 
            @onkeydown="@Enter" 
           @onkeydown:preventDefault="@preventKeyDefault"
            @ref="_inputRef"
            class="form-control filter"
            placeholder="Enter Player..."/>
        @* <InputText @bind-Value="@playerModel.Name" @oninput=HandleInput class="form-control filter" placeholder="Player Name" /> *@ @* Add Option to autocomplete the player name from db *@
        @* <button class="btn btn-outline-primary input-group-text">Add</button> *@
        @if (PlayerNames is not null && PlayerNames.Any())
        {
            <ul class="options">
                @for (int i = 0; i < PlayerNames.Count; i++)
                {
                    var player = PlayerNames[i];
                    var index = i;
                    <li class="dropdown-item @(index == highlightedIndex ? "active bg-primary text-white" : "")"
                        @onclick="() => SelectPlayer(player.id)"
                        style="cursor:pointer;">
                        @player.Name
                    </li>
                }
            </ul>
        }
    </div>

@* </EditForm> *@
@*<input @bind="playerName" @onkeypress="@KeyEnterPressed" @bind:event="oninput"/><button @onclick="@AddPlayer">Add Player</button>*@
<br />

@code {
    private string? filter = string.Empty;
    private uint? selectedPlayerID;
    private string? selectedPlayerName;
    private ElementReference _inputRef;
    private List<Player>? PlayerNames = new List<Player>();
    // For keyboard navigation
    private int highlightedIndex = -1;

    // For conditional preventDefault
    private bool preventKeyDefault = false;
    [Parameter]
    public Player playerModel { get; set; } = new Player();

    public void AddPlayer()
    {
        if (string.IsNullOrEmpty(selectedPlayerName) || Player.Players.Exists(p => p.Name.ToLower() == selectedPlayerName?.ToLower()))
            return;

        if (PlayerNames?.Any(p => p.Name.ToLower() == selectedPlayerName?.ToLower()) == true)
        {
            Player.AddPlayer(PlayerNames.First(p => p.Name.ToLower() == selectedPlayerName?.ToLower()));
        }
        else if (selectedPlayerName is not null)
            Player.AddPlayer(new Player(Player.GetNextPlayerId(), selectedPlayerName));

        if (Payout.PrizeMoney > 0)
        {
            Game.AddSeat();            
        }
        ClearInput();
        ResetAfterAdd();
    }
    private void OnBlur(FocusEventArgs e)
    {
        //Delay clearing the input to allow click event to register
        if (!string.IsNullOrWhiteSpace(filter))
        {
            selectedPlayerName = filter.Trim();
            AddPlayer();
            ClearInput();
        }
    }
    private void Enter(KeyboardEventArgs e)
    {
        preventKeyDefault = false;  // ← Always reset at start

        // No list shown → only allow Enter to add typed name
        if (PlayerNames == null || PlayerNames.Count == 0)
        {
            if (e.Key is "Enter" or "NumpadEnter")
            {
                preventKeyDefault = true;
                selectedPlayerName = string.IsNullOrWhiteSpace(filter) ? null : filter.Trim();
                AddPlayer();
                ResetAfterAdd();  // ← Critical reset
            }
            return;
        }

        // List is visible — handle navigation
        switch (e.Key)
        {
            case "ArrowDown":
                preventKeyDefault = true;
                highlightedIndex = (highlightedIndex + 1) % PlayerNames.Count;
                StateHasChanged();
                break;

            case "ArrowUp":
                preventKeyDefault = true;
                if (highlightedIndex <= 0)
                    highlightedIndex = -1;
                else
                    highlightedIndex--;
                StateHasChanged();
                break;

            case "Tab":
            case "Enter":
            case "NumpadEnter":
                preventKeyDefault = true;
                if (highlightedIndex >= 0 && highlightedIndex < PlayerNames.Count)
                    selectedPlayerName = PlayerNames[highlightedIndex].Name;
                else
                    selectedPlayerName = filter?.Trim();

                AddPlayer();
                ResetAfterAdd();  // ← Critical reset
                break;

            case "Escape":
                preventKeyDefault = true;
                ClearInput();
                ResetAfterAdd();  // ← Also reset here
                break;
        }
    }
    private void ClearInput()
    {
        filter = string.Empty;           // This clears the input box
        PlayerNames = null;
        selectedPlayerID = null;
        selectedPlayerName = null;
        StateHasChanged();
    }

    // Helper method — keeps code clean and ensures reset always happens
    private void ResetAfterAdd()
    {
        preventKeyDefault = false;     // ← This is the fix you asked for
        highlightedIndex = -1;
        // ClearInput() already called in AddPlayer() or Escape
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        filter = e.Value?.ToString();
        highlightedIndex = -1;  // Reset highlight when typing

        if (filter?.Length < 2)
        {
            PlayerNames = null;
            return;
        }

        var allPlayers = await Player.GetPlayerNames();  // All players from DB

        // EXCLUDE players already in the current game
        var currentPlayerNames = Player.Players
            .Select(p => p.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        PlayerNames = allPlayers
            .Where(p => p.Name.Contains(filter ?? "", StringComparison.OrdinalIgnoreCase))
            .Where(p => !currentPlayerNames.Contains(p.Name))  // ← THIS LINE DOES IT
            .OrderBy(p => p.Name)
            .ToList();

        StateHasChanged();
    }
    private void SelectPlayer(uint id)
    {
        selectedPlayerID = id;
        selectedPlayerName = PlayerNames?.First(p => p.id.Equals(id)).Name;
        AddPlayer();
        ClearInput();
    }

    protected override void OnInitialized()
    {
        Player.OnChange += HandleChange;
    }
    protected override async Task OnInitializedAsync()
    {
        await Player.SetNextPlayerID(Game);
    }
    private Task HandleChange() => InvokeAsync(StateHasChanged);
    void IDisposable.Dispose()
    {
        Player.OnChange -= HandleChange;
    }
}
