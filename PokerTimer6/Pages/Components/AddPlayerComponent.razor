@* </EditForm> *@
@*<input @bind="playerName" @onkeypress="@KeyEnterPressed" @bind:event="oninput"/><button @onclick="@AddPlayer">Add Player</button>*@
<br />
<label>Buy-In $<input class="m-lg-1" @bind="@PayoutService.BuyIn" style="width:70px" /></label>
<br />
<button class="oi oi-reload" @onclick="@Game.ResetTournament" title="Reset Tournament"/>
<button class="oi oi-data-transfer-upload" @onclick="Game.SavePlayers" title="Save Player List"/>
<button class="oi oi-data-transfer-download" @onclick="Game.LoadPlayers" title="Load Player List" />
@code {
    private string? filter = string.Empty;
    private uint? selectedPlayerID;
    private string? selectedPlayerName;
    private List<Player>? PlayerNames = new List<Player>();

    [Parameter]
    public Player playerModel { get; set; } = new Player();

    public void AddPlayer()
    {
        if (Player.Players.Exists(p => p.Name.ToLower() == selectedPlayerName?.ToLower()) | string.IsNullOrEmpty(selectedPlayerName))  //if the player already exists or empty...return
            return;
        if (PlayerNames?.Any(p=>p.Name.ToLower() == selectedPlayerName?.ToLower()) == true)
        {
            Player.AddPlayer(PlayerNames.First(p => p.Name.ToLower() == selectedPlayerName?.ToLower()));
        }
        else if (selectedPlayerName is not null) Player.AddPlayer(new Player(Player.GetNextPlayerId(), selectedPlayerName));
        if (Payout.PrizeMoney > 0)
        {
            Game.AddSeat();
            ClearInput();
        }

        // playerModel.Name = "";

    }

    private void Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            if (selectedPlayerName == null ? true : !selectedPlayerName.ToLower().Contains(filter?.ToLower()))
                selectedPlayerName = filter;
            AddPlayer();
            ClearInput();
        }
        if (e.Code == "ArrowDown" && PlayerNames?.Count > 0)
        {
            selectedPlayerName = PlayerNames?.SkipWhile(x => x.Name.ToLower() != selectedPlayerName?.ToLower()).Skip(1).DefaultIfEmpty(PlayerNames[0]).FirstOrDefault()?.Name;
        }
        if (e.Code == "ArrowUp" && PlayerNames?.Count > 0)
        {
            selectedPlayerName = PlayerNames?.TakeWhile(x => x.Name.ToLower() != selectedPlayerName?.ToLower()).DefaultIfEmpty(PlayerNames[PlayerNames.Count - 1]).LastOrDefault()?.Name;
        }
        if (e.Code == "Escape")
        {
            ClearInput();
        }
    }
    private void ClearInput()
    {
        filter = null;
        PlayerNames = null;
        selectedPlayerID = null;
        selectedPlayerName = null;
        StateHasChanged();
    }
    private async Task HandleInput(ChangeEventArgs e)
    {
        filter = e.Value?.ToString();    
        if (filter?.Length > 1)
        {
            var playerList = await Game.GetPlayerNames();
            PlayerNames = playerList.Where(p => p.Name.ToLower().Contains(filter.ToLower())).OrderBy(i=>i.Name).ToList();  //filtered list of names
        }
        else
        {
            PlayerNames = null;
            selectedPlayerID = null;
            selectedPlayerName = null;
        }
    }
    private void SelectPlayer(uint id)
    {
        selectedPlayerID = id;
        selectedPlayerName = PlayerNames?.First(p => p.id.Equals(id)).Name;
        AddPlayer();
        PlayerNames = null;
        selectedPlayerName = null;
        selectedPlayerID = null;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        Player.OnChange += async () => await InvokeAsync(StateHasChanged);
        Game.OnChange += async () => await InvokeAsync(StateHasChanged);
        Payout.OnChange += async () => await InvokeAsync(StateHasChanged);
        await Player.SetNextPlayerID(Game);
        await base.OnInitializedAsync();
    }
    void IDisposable.Dispose()
    {
        Player.OnChange -= async () => await InvokeAsync(StateHasChanged);
        Game.OnChange -= async () => await InvokeAsync(StateHasChanged);
        Payout.OnChange -= async () => await InvokeAsync(StateHasChanged);
    }
}
