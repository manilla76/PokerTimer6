@inject IGameService Game
@inject IPlayerService Player
@inject IPayoutService Payout
@implements IDisposable

<div class="col-4">
    <EditForm EditContext="@editContext">
         <DataAnnotationsValidator />
     @*  <ValidationSummary /> *@
        @* <DataListSelect DataList="PlayerDictionary" @bind-Value="PlayerModel" RestrictToList="false" class="form-control" placeholder="Enter name..."></DataListSelect> *@
        <DataListString DataList="playerValues" @bind-Value="PlayerNameFromDataList" RestrictToList="false" class="form-control" placeholder="Enter name..."></DataListString>
    </EditForm>
</div>
<br />
<label>Buy-In $<input class="m-lg-1" @bind="@PayoutService.BuyIn" style="width:70px" /></label>
<br />
<button class="oi oi-reload" @onclick="@Game.ResetTournament" title="Reset Tournament"/>
<button class="oi oi-data-transfer-upload" @onclick="Game.SavePlayers" title="Save Player List"/>
<button class="oi oi-data-transfer-download" @onclick="Game.LoadPlayers" title="Load Player List" />
@code {
    private string? filter = string.Empty;
    private uint? selectedPlayerID => playerModel.id;
    private string? selectedPlayerName => playerModel.Name;
    private string? inputPlayerName = string.Empty;
    private List<Player>? PlayerNames = new List<Player>();
    private EditContext editContext = new EditContext(new Player());
    private string playerNameFromDataList = string.Empty;
    public string PlayerNameFromDataList { get => playerNameFromDataList;
        set
        {
            if (value is not null)
            {
                playerNameFromDataList = value;
                AddPlayer(value);
            }
            editContext = new EditContext(new Player());
        } }
    private SortedDictionary<Player, string>? PlayerDictionary
    {
        get
        {
            return Game.GetPlayerDictionary().Result;
        }
    }
    private string GetValueFromKey(Player player) => PlayerDictionary?.GetValueOrDefault(player) ?? string.Empty;
    private IEnumerable<string>? playerValues => PlayerDictionary?.Values.Where(p1 => Player.Players.All(p2 => !p1.Equals(p2.Name, StringComparison.CurrentCultureIgnoreCase))) ?? default;
    private Player? playerModel;
    [Parameter]
    public Player? PlayerModel
    {
        get { return playerModel; }
        set 
        {
            if (value is not null)
            {
                playerModel = value;
                AddPlayer();
            }
            else
            {
                var messages = editContext.GetValidationMessages();
                if (messages is not null && messages.Count() > 0 && messages.Where(i => i.Contains("Player: ")).Count() > 0)
                    {
                        string playerMessage = messages.First(i => i.Contains("Player: ")).Replace("Player: ", "");
                        AddPlayer(playerMessage);
                    }
            }
            editContext = new EditContext(new Player());
        }
    }

    public void AddPlayer()
    {
        if (string.IsNullOrEmpty(selectedPlayerName)) return;
        if (Player.Players.Exists(p => p.Name.ToLower() == selectedPlayerName?.ToLower()) | string.IsNullOrEmpty(selectedPlayerName))  //if the player already exists or empty...return
            return;
        if (PlayerNames?.Any(p=>p.Name.ToLower() == selectedPlayerName?.ToLower()) == true)
        {
            Player.AddPlayer(PlayerNames.First(p => p.Name.ToLower() == selectedPlayerName?.ToLower()));
        }
        else if (selectedPlayerName is not null) Player.AddPlayer(new Player(Player.GetNextPlayerId(), selectedPlayerName));
        if (Payout.PrizeMoney > 0)
        {
            Game.AddSeat();
            //ClearInput();
        }

        // playerModel.Name = "";
        StateHasChanged();
    }
    public void AddPlayer(string playername)
    {
        PlayerModel = new Player(Player.GetNextPlayerId(), playername);
        AddPlayer();
    }

    protected override async Task OnInitializedAsync()
    {
        Player.OnChange += async () => await InvokeAsync(StateHasChanged);
        Game.OnChange += async () => await InvokeAsync(StateHasChanged);
        Payout.OnChange += async () => await InvokeAsync(StateHasChanged);
        await Player.SetNextPlayerID(Game);
        PlayerNames = await Game.GetPlayerNames();
        //PlayerDictionary = await Game.GetPlayerDictionary();
        await base.OnInitializedAsync();
    }
    void IDisposable.Dispose()
    {
        Player.OnChange -= async () => await InvokeAsync(StateHasChanged);
        Game.OnChange -= async () => await InvokeAsync(StateHasChanged);
        Payout.OnChange -= async () => await InvokeAsync(StateHasChanged);
    }
}
