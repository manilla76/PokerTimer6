@inject IGameService Game
@implements IDisposable
@rendermode InteractiveServer

<h3>Upcoming Rounds</h3>
@if (Game.Rounds.Count == 0)
{
    <p><em>Add Rounds</em></p>
}
else
{
    <table class="table table-striped" style="width:50%">
        <thead>
            <tr>
                <th width="1%">-</th>
                <th class="text-center, fw-bold">SB</th>
                <th class="text-center, fw-bold">BB</th>
                <th style="text-center, fw-bold">Time</th>
                <th/>
            </tr>
        </thead>
        <tbody>
            @foreach (var round in Game.Rounds)
            {
                <tr>
                    <RoundComponent round="round"/>
                </tr>
            }
        </tbody>
    </table>

}
<AddRoundComponent/>
<button class="oi oi-data-transfer-upload" @onclick="async () => await Game.SaveRoundLayoutAsync()" title="Update Selected Round List" />
<button class="oi oi-data-transfer-download" @onclick="async () => await Game.LoadRoundLayoutAsync()" title="Load Round List" />
<button class="oi oi-cloud-upload" @onclick="async () => await Game.NewRoundLayoutAsync()" title="Save As New Round List"/>
<div class="col-3">
    <label for="tournamentID"/>
    <InputSelect id="tournamentID" class="form-select" @bind-Value="Game.TournamentID">
        @foreach (var item in Game.TournamentList)
        {
            <option value="@item">@item</option>
        }
    </InputSelect>
</div>


@code {

    private List<int> TournamentList = new List<int>{ 1, 2, 3, 4 };
    private int tournamentID;
    protected override void OnInitialized()
    {
        Game.OnChange += HandleChange;    
    }
    protected override async Task OnInitializedAsync()
    {
        await Game.LoadTournamentListAsync();
        await base.OnInitializedAsync();
    }
    private Task HandleChange() => InvokeAsync(StateHasChanged);

    void IDisposable.Dispose()
    {
        Game.OnChange -= HandleChange;
    }
}
