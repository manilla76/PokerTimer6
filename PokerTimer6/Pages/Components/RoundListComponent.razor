@inject IGameService Game
@implements IDisposable

<h3>Upcoming Rounds</h3>
@if (Game.Rounds.Count == 0)
{
    <p><em>Add Rounds</em></p>
}
else
{
    <table class="table table-striped" style="width:50%">
        <thead>
            <tr>
                <th width="1%">-</th>
                <th class="text-center, fw-bold">SB</th>
                <th class="text-center, fw-bold">BB</th>
                <th style="text-center, fw-bold">Time</th>
                <th/>
            </tr>
        </thead>
        <tbody>
            @foreach (var round in Game.Rounds)
            {
                <tr>
                    <RoundComponent round="round"/>
                </tr>
            }
        </tbody>
    </table>

}
<AddRoundComponent/>
<button class="oi oi-data-transfer-upload" @onclick="Game.SaveRoundLayoutAsync" title="Save Round List" />
<button class="oi oi-data-transfer-download" @onclick="Game.LoadRoundLayoutAsync" title="Load Round List" />

@code {
    protected override Task OnInitializedAsync()
    {
        Game.OnChange += async () => await InvokeAsync(StateHasChanged);
        return base.OnInitializedAsync();
    }

    void IDisposable.Dispose()
    {
        Game.OnChange -= async () => await InvokeAsync(StateHasChanged);
    }
}
