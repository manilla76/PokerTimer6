@inject IGameService Game
@implements IDisposable

<h3>Upcoming Rounds</h3>
@if (!Game.Rounds.Any())
{
    <p><em>Add Rounds</em></p>
}
else
{
    <table class="table table-striped" style="width:50%">
        <thead>
            <tr>
                <th width="1%">-</th>
                <th class="text-center fw-bold">SB</th>
                <th class="text-center fw-bold">BB</th>
                <th class="text-center fw-bold">Time</th>
                <th/>
            </tr>
        </thead>
        <tbody>
            @foreach (var round in Game.Rounds)
            {
                <tr>
                    <RoundComponent round="round"/>
                </tr>
            }
        </tbody>
    </table>
}
<AddRoundComponent/>
<button class="oi oi-data-transfer-upload" @onclick="SaveRoundLayoutAsync" title="Update Selected Round List" />
<button class="oi oi-data-transfer-download" @onclick="LoadRoundLayoutAsync" title="Load Round List" />
<button class="oi oi-cloud-upload" @onclick="NewRoundLayoutAsync" title="Save As New Round List"/>
<div class="col-3">
    <label for="tournamentID"/>
    <InputSelect id="tournamentID" class="form-select" @bind-Value="Game.TournamentID">
        @foreach (var item in Game.TournamentList)
        {
            <option value="@item">@item</option>
        }
    </InputSelect>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Game.OnChange += OnGameChange;
        await Game.LoadTournamentListAsync();
        await base.OnInitializedAsync();
    }

    private void OnGameChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SaveRoundLayoutAsync()
    {
        await Game.SaveRoundLayoutAsync();
    }

    private async Task LoadRoundLayoutAsync()
    {
        await Game.LoadRoundLayoutAsync();
    }

    private async Task NewRoundLayoutAsync()
    {
        await Game.NewRoundLayoutAsync();
    }

    void IDisposable.Dispose()
    {
        Game.OnChange -= OnGameChange;
    }
}
