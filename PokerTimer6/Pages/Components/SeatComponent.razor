@inject IPlayerService Player
@inject IGameService Game
@implements IDisposable

@*<h3>SeatComponent</h3>*@

@if (Player.Players.Count == 0)
{
    <p><em>Add Players</em></p>  
}
else
{
    <div class="container-fluid">
        <div class="row">
            @for (int i = 1; i <= (Player.ActiveList.Count - 1) / 10 + 1; i++)   // table count  0 = 0 table; 1-10 = 1 table; 11-20 = 2 table
            {
                var table = i;
                <div class="col-lg-6 col-sm-12">
                    <button class="h1 btn-info btn-toolbar" @onclick="() => Player.SetDealer(table)" title="Randomize dealer for this table.">Table @table</button>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Seat</th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in Player.ActiveList.Where(p=>p.Player_Seat.TableNumber == @table).OrderBy(t=>t.Player_Seat.SeatNumber))
                            {
                                <tr>
                                    
                                    @if (Player.Dealers.Count > 0 ? player.Player_Seat.SeatNumber == Player.Dealers[table - 1] : false )    // Check if this player is the dealer for this table
                                    {
                                        <td class="fw-bold fs-4 text-warning">@player.Name</td> }  // highlight dealer
                                    else{
                                        <td>@player.Name</td> }
                                    <td align="center">@player.Player_Seat.SeatNumber</td>
                                    <td/>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
<div class="mx-3 col-lg-6 col-sm-12">
    <p class="fw-bold fs-6 text-warning">Dealer Highlighted</p>
    <button @onclick="@Game.ShufflePlayers">Randomize</button> <br/>
    Starting # of Players: @Player.StartingNumberOfPlayers <br/>
    Current # of Players: @Player.ActiveList.Count
</div>
@code {
    protected override void OnInitialized()
    {
        Player.OnChange += HandleChange;
    }
    private Task HandleChange() => InvokeAsync(StateHasChanged);

    void IDisposable.Dispose()
    {
        Player.OnChange -= HandleChange;
    }

}
