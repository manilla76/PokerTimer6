@inject ITimerService TimerService
@inject IGameService Game
@inject IJSRuntime _jsRuntime
@implements IDisposable

<audio id="alert" src="../Sounds/mixkit-bell-notification-933.wav"/>

<div class="container-fluid">
    <div class="text-center">
         <p class="display-1">SB / BB</p>
         <br/>
@if (Game.CurrentRound is null)
    {
            <p class="display-1 text-danger">- / -</p>
    }
else if (Game.CurrentRound.SmallBlind == 0)
    {
        <p class="display-1 align-content-center text-primary">BREAK</p>    
    }
else if (Game.CurrentRound.SmallBlind <= 0)
    {
        <p class="display-1 text-danger">Break</p>
    }
else
    {
        <p class="display-1 text-danger">@Game.CurrentRound.SmallBlind / @Game.CurrentRound.BigBlind</p>
    }
    </div>
    <h1 class="timer" style="text-align:center">@TimerService.DisplayValue</h1>
    <br />
    <div style="text-align:center">
    <button title="Play/Pause" disabled="@PlayButtonDisabled" class="btn btn-outline" @onclick="async () => {await TimerService.StartPauseAsync(); TimerService.ChangeIcon();}">
        <i class="@TimerService.IconString"/></button>
    <button title="Next Round" class="btn btn-outline-danger" @onclick="async () => {await GetNextRound(); }">
        <i class="oi oi-media-step-forward"/></button>
    </div>
</div>
@if (ErrorStringEmpty())
{
    <p>Error = @errorString</p>
}
@code
{
    private string errorString = string.Empty;
    public bool PlayButtonDisabled = false;
    public bool roundsEntered = false;

    private bool ErrorStringEmpty() => !string.IsNullOrEmpty(errorString);

    protected override Task OnInitializedAsync()
    {
        roundsEntered = Game.Rounds.Count == 0;
        TimerService.OnChange += async () => await InvokeAsync(StateHasChanged);
        return base.OnInitializedAsync();
    }

    private async void ValueChanged()
    {       
        try
        {
            if (TimerService.SoundAlert)
            {
                await PlaySound();
            }
        }
        catch (Exception ex)
        {
            errorString = ex.Message;
        }
        TimerService.ChangeIcon();
        await InvokeAsync(StateHasChanged);
    }

    public async Task PlaySound()
    {
        await _jsRuntime.InvokeAsync<string>("PlaySound", "alert");
    }

    void IDisposable.Dispose()
    {
        TimerService.OnChange -= async () => await InvokeAsync(StateHasChanged);
    }

    private async Task GetNextRound()
    {
        if (Game.Rounds.Count >= 0)
        {
            Game.SetCurrentRound();
            TimerService.SetTimeRemaining(Game.CurrentRound.RoundTime);
            await TimerService.StopAsync();
            //smallBlind = Game.CurrentRound.SmallBlind.ToString() ?? "x";
            //bigBlind = Game.CurrentRound.BigBlind.ToString() ?? "x";
            TimerService.ChangeIcon();
        }
    }
}
