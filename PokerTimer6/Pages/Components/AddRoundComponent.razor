@using System.ComponentModel.DataAnnotations
@inject IGameService Game
@rendermode InteractiveServer

<div class="col m-1">
    <EditForm Model="@RoundModel"
              OnValidSubmit="@HandleValidSubmit"
              FormName="AddRoundForm"
              class="row pb-1">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="col ps-2">
            <!-- single input-group ensures exact matching heights -->
            <div class="input-group input-group-sm w-auto">

                <InputNumber @bind-Value="RoundModel.BigBlind"
                             class="form-control me-2"
                             placeholder="Big Blind"
                             size="7"
                             style="max-width: 100px;" />

                <InputNumber @bind-Value="RoundModel.RoundMinutes"
                             class="form-control"
                             placeholder="Mins"
                             size="7"
                             style="max-width: 100px;" />

                <button type="submit" class="btn btn-outline-primary mx-1">+</button>

            </div>
        </div>

    </EditForm>
</div>


@code {
    // ← THIS IS THE ONLY CHANGE THAT MATTERS
    private RoundForm RoundModel { get; set; } = new();   // private + no auto-reset

    private void HandleValidSubmit()
    {
        // At this exact moment, RoundModel HAS the correct values
        Game.AddRound(new Round { 
            RoundMinutes = RoundModel.RoundMinutes,
            BigBlind = RoundModel.BigBlind
        });

        // Now intentionally clear the form for the next round
        RoundModel.BigBlind = null;

        // If you are on Blazor Server and Game doesn't trigger StateHasChanged,
        // you may need it here:
        // StateHasChanged();
    }

    private record RoundForm
    {
        [Range(1, int.MaxValue, ErrorMessage = "Big Blind must be at least 1")]
        public int? BigBlind { get; set; }
        
        [Required, Range(1, 1000, ErrorMessage = "Minutes must be at least 1")]
        public int? RoundMinutes { get; set; }

    }
}

