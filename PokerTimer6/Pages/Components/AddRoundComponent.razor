@inject IGameService Game

<EditForm Model="@RoundModel"
          OnValidSubmit="@HandleValidSubmit"
          FormName="AddRoundForm"
          class="row pb-1">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="col ps-2">
        <InputNumber @bind-Value="RoundModel.BigBlind"
                     class="form-control"
                     placeholder="Big Blind" />
    </div>

    <div class="col p-0">
        <div class="input-group">
            <InputNumber @bind-Value="RoundModel.RoundMinutes"
                         class="form-control"
                         placeholder="Mins" />
            <button type="submit" class="btn btn-outline-primary">+</button>
        </div>
    </div>
</EditForm>

@code {
    // ← THIS IS THE ONLY CHANGE THAT MATTERS
    private Round RoundModel { get; set; } = new();   // private + no auto-reset

    // If Game changes the collection and causes parent re-render, we must not recreate the model
    protected override void OnInitialized()
    {
        // You can even move the "new()" here if you prefer
        // RoundModel = new Round();
    }

    private void HandleValidSubmit()
    {
        // At this exact moment, RoundModel HAS the correct values
        Game.AddRound(RoundModel);

        // Now intentionally clear the form for the next round
        RoundModel = new Round();

        // If you are on Blazor Server and Game doesn't trigger StateHasChanged,
        // you may need it here:
        // StateHasChanged();
    }
}

