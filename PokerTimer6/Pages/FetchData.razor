@page "/fetchdata"
@using PokerLibrary
@using PokerLibrary.Models
@inject IPokerData db

<PageTitle>TestPokerData</PageTitle>


<h1>Poker Data</h1>
<h4>Insert new player</h4>
<EditForm Model="@newPlayer" OnValidSubmit="@AddPlayer">
    <DataAnnotationsValidator/>
    <ValidationSummary/>
    <InputText id="name" @bind-Value="newPlayer.Name"/>
    <InputNumber id="table" @bind-Value="newPlayer.Table"/>
    <InputNumber id="seat" @bind-Value="newPlayer.Seat"/>
    <button type="submit" class="btn btn-primary">Submit</button>
</EditForm>

<h4>Current Players</h4>

@if (players == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Table</th>
                <th>Seat</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var player in players)
            {
                <tr>
                    <td>@player.Name</td>
                    <td>@player.Table</td>
                    <td>@player.Seat</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<PlayerModel> players;
    private Player newPlayer = new ();

    protected override async Task OnInitializedAsync()
    {
        players = await db.GetPlayers();
    }

    private async Task AddPlayer()
    {
        PlayerModel p = new PlayerModel
        {
            Name = newPlayer.Name,
            Table = newPlayer.Table,
            Seat = newPlayer.Seat
        };
        await db.InsertPlayer(p);
        players.Add(p);
    }
}
